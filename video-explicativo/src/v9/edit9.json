   "srcStart": 68.02,
   "srcEnd": 68.04,
   "start": 62.287,
   "end": 62.307
  },
  {
   "text": "compartilhe.",
   "seg": 34,
   "srcStart": 68.03,
   "srcEnd": 68.3,
   "start": 62.297,
   "end": 62.567
  }
 ],
 "sentences": [
  {
   "seg": 0,
   "text": "Um dos meus maiores problemas nunca foi a falta de ideias,",
   "start": 0.0,
   "end": 2.433
  },
  {
   "seg": 1,
   "text": "mas sim de tempo para transformar essas ideias em conteúdo.",
   "start": 2.433,
   "end": 5.467
  },
  {
   "seg": 2,
   "text": "Tenho que parar, gravar, repetir partes, editar, colocar legendas",
   "start": 5.467,
   "end": 9.633
  },
  {
   "seg": 3,
   "text": "e publicar.",
   "start": 9.633,
   "end": 10.367
  },
  {
   "seg": 4,
   "text": "E quando tens trabalho, responsabilidades e outras prioridades,",
   "start": 10.367,
   "end": 13.3
  },
  {
   "seg": 5,
   "text": "produzir conteúdo",
   "start": 13.3,
   "end": 14.267
  },
  {
   "seg": 6,
   "text": "constantemente torna-se um pouco complicado.",
   "start": 14.267,
   "end": 16.367
  },
  {
   "seg": 7,
   "text": "Até que pude perceber que podia utilizar a inteligência artificial",
   "start": 16.367,
   "end": 19.433
  },
  {
   "seg": 8,
   "text": "para mudar completamente este processo.",
   "start": 19.433,
   "end": 20.947
  },
  {
   "seg": 9,
   "text": "Hoje eu pego todo o meu conhecimento,",
   "start": 21.103,
   "end": 22.567
  },
  {
   "seg": 10,
   "text": "ideias e tudo aquilo que eu aprendo, transformo isso em um roteiro,",
   "start": 22.567,
   "end": 25.267
  },
  {
   "seg": 11,
   "text": "prompts e vídeos.",
   "start": 25.267,
   "end": 26.367
  },
  {
   "seg": 12,
   "text": "A ideia",
   "start": 26.367,
   "end": 26.9
  },
  {
   "seg": 13,
   "text": "continua a ser a minha. A inteligência artificial ajuda a estruturar a mensagem,",
   "start": 26.9,
   "end": 30.133
  },
  {
   "seg": 14,
   "text": "a melhorar os roteiros",
   "start": 30.133,
   "end": 31.267
  },
  {
   "seg": 15,
   "text": "e a construir",
   "start": 31.267,
   "end": 31.9
  },
  {
   "seg": 16,
   "text": "todas as cenas visuais.",
   "start": 31.9,
   "end": 33.067
  },
  {
   "seg": 17,
   "text": "E com ferramentas como o Remotion, consigo preparar este processo em vários vídeos dinâmicos",
   "start": 33.067,
   "end": 37.0
  },
  {
   "seg": 18,
   "text": "e produzir vários conteúdos",
   "start": 37.0,
   "end": 38.537
  },
  {
   "seg": 19,
   "text": "em um só dia.",
   "start": 38.537,
   "end": 39.3
  },
  {
   "seg": 20,
   "text": "E atenção.",
   "start": 39.3,
   "end": 40.0
  },
  {
   "seg": 21,
   "text": "Isso não significa substituir a sua imagem ou deixar de aparecer.",
   "start": 40.0,
   "end": 43.067
  },
  {
   "seg": 22,
   "text": "Significa que vais ter uma ferramenta que vai te ajudar a partilhar o seu conhecimento,",
   "start": 43.067,
   "end": 46.94
  },
  {
   "seg": 23,
   "text": "conectar e agregar as pessoas,",
   "start": 46.94,
   "end": 48.467
  },
  {
   "seg": 24,
   "text": "mesmo",
   "start": 48.467,
   "end": 48.883
  },
  {
   "seg": 25,
   "text": "que não tenhas tempo",
   "start": 48.883,
   "end": 49.733
  },
  {
   "seg": 26,
   "text": "para estar diante das câmeras.",
   "start": 49.733,
   "end": 50.67
  },
  {
   "seg": 27,
   "text": "Se tens conhecimento para partilhar, mas o tempo te limita,",
   "start": 50.797,
   "end": 53.267
  },
  {
   "seg": 28,
   "text": "isso não significa que tu tens que trabalhar mais.",
   "start": 53.267,
   "end": 55.297
  },
  {
   "seg": 29,
   "text": "Significa que talvez precisas mudar o seu processo.",
   "start": 55.297,
   "end": 58.1
  },
  {
   "seg": 30,
   "text": "Para isso,",
   "start": 58.1,
   "end": 58.6
  },
  {
   "seg": 31,
   "text": "siga o meu perfil, que eu vou mostrar tudo isso todos os dias.",
   "start": 58.6,
   "end": 61.27
  },
  {
   "seg": 32,
   "text": "Deixe o seu like,",
   "start": 61.27,
   "end": 61.867
  },
  {
   "seg": 33,
   "text": "curte",
   "start": 61.867,
   "end": 62.2
  },
  {
   "seg": 34,
   "text": "e compartilhe.",
   "start": 62.2,
   "end": 62.783
  }
 ]
}